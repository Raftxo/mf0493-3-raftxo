---
import BaseLayout from '../../layouts/BaseLayout.astro';

// BASE_URL es '/' en local y '/nombre-repo/' al publicar en GitHub Pages.
const base = import.meta.env.BASE_URL;

// Índice automático del blog: añade un objeto por cada artículo.
// Si cambias el título de un artículo, actualízalo también aquí.
// Las rutas se escriben sin la barra inicial: se les añade BASE_URL al renderizar.
const articulos = [
  {
    title: 'Cómo preparar la primera visita de tu cachorro',
    href: 'blog/articulo-1/',
    description: 'Documentación, preguntas clave y pautas para comenzar la atención veterinaria de tu cachorro.',
  },
  {
    title: 'Señales de alarma que no debes pasar por alto',
    href: 'blog/articulo-2/',
    description: 'Reconoce los cambios que requieren una revisión veterinaria rápida y cuándo acudir a urgencias.',
  },
];
---

<BaseLayout title="Blog | Clínica Veterinaria Patitas" description="Consejos prácticos sobre prevención, alimentación y bienestar para perros y gatos escritos por el equipo de Clínica Patitas.">
  <h1>Consejos para una mascota sana</h1>

  <ul>
    {articulos.map((articulo) => (
      <li>
        <h2><a href={`${base}${articulo.href}`}>{articulo.title}</a></h2>
        <p>{articulo.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
